# =============================================================================
# ESP32-P4-XiaoZhi 默认配置
# 目标板: Waveshare ESP32-P4-WIFI6-Touch-LCD-4.3 (P4 rev1.3 + ESP32-C6 + 4.3" IPS)
# 工具链: ESP-IDF v5.5.x（微雪 FAQ 推荐 v5.5.1~v5.5.4）
#
# ★ Wi-Fi 稳定性：采用与出厂固件一致的 ESP-Hosted 1.4.x 主机线
#   （main/idf_component.yml: esp_hosted 1.4.7 + esp_wifi_remote 0.14.5）。
#   出厂 C6 固件与 hosted 2.x 主机在音频突发流量下会出现 SDIO 超时
#   （"Unrecoverable host sdio state"）并触发重启，因此锁定 1.4.x。
# =============================================================================

CONFIG_IDF_TARGET="esp32p4"
# 本板 ESP32-P4 为 rev1.3；必须显式选择 "<3.0 支持" 否则默认要求 rev3.1，
# 烧录时会报 "requires chip revision in range [v3.1 - v3.99]"（IDF 5.5/6.x 同理）
CONFIG_ESP32P4_SELECTS_REV_LESS_V3=y
CONFIG_ESP32P4_REV_MIN_100=y

# ---------------- Flash / PSRAM ----------------
CONFIG_ESPTOOLPY_FLASHMODE_QIO=y
CONFIG_ESPTOOLPY_FLASHSIZE_32MB=y
CONFIG_ESPTOOLPY_FLASHSIZE="32MB"
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_HEX=y
CONFIG_SPIRAM_SPEED_200M=y
CONFIG_SPIRAM_XIP_FROM_PSRAM=y
CONFIG_CACHE_L2_CACHE_256KB=y
CONFIG_CACHE_L2_CACHE_LINE_128B=y
# 内存策略（与出厂固件一致）：malloc 优先 PSRAM，内部 RAM 留给 DMA/任务栈，
# 避免 ESP-Hosted 启动期把内部 RAM 吃光。
CONFIG_SPIRAM_MALLOC_ALWAYSINTERNAL=0
CONFIG_SPIRAM_MALLOC_RESERVE_INTERNAL=4096

# ---------------- CPU / OS ----------------
CONFIG_COMPILER_OPTIMIZATION_PERF=y
CONFIG_ESP_MAIN_TASK_STACK_SIZE=10240
CONFIG_FREERTOS_HZ=1000

# ---------------- Partition table ----------------
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
CONFIG_PARTITION_TABLE_OFFSET=0x8000

# ---------------- Wi-Fi (板载 ESP32-C6, ESP-Hosted over SDIO) ----------------
CONFIG_SLAVE_IDF_TARGET_ESP32C6=y
CONFIG_WIFI_RMT_STATIC_RX_BUFFER_NUM=16
CONFIG_WIFI_RMT_DYNAMIC_RX_BUFFER_NUM=64
CONFIG_WIFI_RMT_DYNAMIC_TX_BUFFER_NUM=64
# AMPDU 聚合（出厂固件同款，提高吞吐、减少单帧事务）
CONFIG_WIFI_RMT_AMPDU_TX_ENABLED=y
CONFIG_WIFI_RMT_TX_BA_WIN=32
CONFIG_WIFI_RMT_AMPDU_RX_ENABLED=y
CONFIG_WIFI_RMT_RX_BA_WIN=32
CONFIG_LWIP_TCP_SND_BUF_DEFAULT=65534
CONFIG_LWIP_TCP_WND_DEFAULT=65534
CONFIG_LWIP_TCP_RECVMBOX_SIZE=64
CONFIG_LWIP_UDP_RECVMBOX_SIZE=64
CONFIG_LWIP_TCPIP_RECVMBOX_SIZE=64
CONFIG_LWIP_TCP_SACK_OUT=y

# ---------------- LVGL (字体 + 内存) ----------------
CONFIG_LV_OS_FREERTOS=y
CONFIG_LV_USE_CLIB_MALLOC=y
CONFIG_LV_USE_CLIB_STRING=y
CONFIG_LV_USE_CLIB_SPRINTF=y
CONFIG_LV_USE_FONT_PLACEHOLDER=y
CONFIG_LV_BUILD_EXAMPLES=n
# 中文使用自刻全量字库 main/assets/font_tk_16.c（lv_font_conv 从 Source Han Sans SC 生成，
# 覆盖 4E00-9FFF 全部汉字 + 常用标点/全角，4bpp 无压缩），
# 不再使用内置的 Source Han Sans 子集字体（缺字多）。
# 字库 bitmap 超过 1MB，必须打开 LARGE（bitmap_index 位宽 20->22 位）。
CONFIG_LV_FONT_FMT_TXT_LARGE=y
# CONFIG_LV_FONT_SOURCE_HAN_SANS_SC_14_CJK is not set
# CONFIG_LV_FONT_SOURCE_HAN_SANS_SC_16_CJK is not set

# ---------------- Waveshare BSP ----------------
CONFIG_BSP_LCD_DPI_BUFFER_NUMS=3
CONFIG_BSP_LCD_COLOR_FORMAT_RGB565=y
CONFIG_CODEC_I2C_BACKWARD_COMPATIBLE=n

# ---------------- 离线唤醒词 / 语音前端（ESP-SR）----------------
# 唤醒词「小特小特」（wn9_xiaotexiaote_tts2），离线识别；唤醒后 VAD 自动断句。
CONFIG_XZ_WAKEWORD_ENABLE=y
CONFIG_XZ_WAKEWORD_AUTO_STOP_MS=1000
CONFIG_MODEL_IN_FLASH=y
CONFIG_AFE_INTERFACE_V1=y
# 模型选择（XZ_WAKEWORD_ENABLE 的 select 也会打开；此处显式写出便于检索/替换唤醒词）
CONFIG_SR_WN_WN9_XIAOTEXIAOTE_TTS2=y
# NS/VAD 使用默认 WebRTC（体积小、够用）

# ---------------- Xiaozhi 服务端地址 ----------------
# 占位值；真实值请放在 sdkconfig.defaults.local（已被 .gitignore 忽略），
# 用 SDKCONFIG_DEFAULTS="sdkconfig.defaults;sdkconfig.defaults.local" 生成配置，
# 或在 menuconfig -> Xiaozhi Assistant -> Default OTA URL 里修改。
CONFIG_XIAOZHI_OTA_URL="http://192.168.1.100:8000/xiaozhi/ota/"
CONFIG_XIAOZHI_INFO_TIMEOUT_MS=8000
