# =============================================================================
# ESP32-P4-XiaoZhi 默认配置
# 目标板: Waveshare ESP32-P4-WIFI6-Touch-LCD-4.3 (P4 rev1.3 + ESP32-C6 + 4.3" IPS)
# 工具链: ESP-IDF v6.0.x（本机已装 v6.0.3；v6.1 与 esp_hosted 2.12 有已知兼容问题）
# =============================================================================

CONFIG_IDF_TARGET="esp32p4"
# 本板 ESP32-P4 为 rev1.3；必须显式选择 "<3.0 支持" 否则默认要求 rev3.1，
# 烧录时会报 "requires chip revision in range [v3.1 - v3.99]"
CONFIG_ESP32P4_SELECTS_REV_LESS_V3=y
CONFIG_ESP32P4_REV_MIN_100=y

# ---------------- Flash / PSRAM ----------------
CONFIG_ESPTOOLPY_FLASHMODE_QIO=y
CONFIG_ESPTOOLPY_FLASHSIZE_32MB=y
CONFIG_ESPTOOLPY_FLASHSIZE="32MB"
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_HEX=y
CONFIG_SPIRAM_SPEED_200M=y
CONFIG_SPIRAM_XIP_FROM_PSRAM=y
CONFIG_CACHE_L2_CACHE_256KB=y
CONFIG_CACHE_L2_CACHE_LINE_128B=y

# ---------------- CPU / OS ----------------
CONFIG_COMPILER_OPTIMIZATION_PERF=y
CONFIG_ESP_MAIN_TASK_STACK_SIZE=10240
CONFIG_FREERTOS_HZ=1000

# ---------------- Partition table ----------------
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
CONFIG_PARTITION_TABLE_OFFSET=0x8000

# ---------------- Wi-Fi (板载 ESP32-C6, ESP-Hosted over SDIO) ----------------
# 依赖版本在 main/idf_component.yml 里锁定（IDF>=6 线: esp_hosted 2.12.x）。
CONFIG_SLAVE_IDF_TARGET_ESP32C6=y
CONFIG_WIFI_RMT_STATIC_RX_BUFFER_NUM=16
CONFIG_WIFI_RMT_DYNAMIC_RX_BUFFER_NUM=64
CONFIG_WIFI_RMT_DYNAMIC_TX_BUFFER_NUM=64
CONFIG_LWIP_TCP_SND_BUF_DEFAULT=65534
CONFIG_LWIP_TCP_WND_DEFAULT=65534
CONFIG_LWIP_TCP_RECVMBOX_SIZE=64
CONFIG_LWIP_UDP_RECVMBOX_SIZE=64
CONFIG_LWIP_TCPIP_RECVMBOX_SIZE=64
CONFIG_LWIP_TCP_SACK_OUT=y

# ---------------- LVGL (字体 + 内存) ----------------
CONFIG_LV_OS_FREERTOS=y
CONFIG_LV_USE_CLIB_MALLOC=y
CONFIG_LV_USE_CLIB_STRING=y
CONFIG_LV_USE_CLIB_SPRINTF=y
CONFIG_LV_FONT_SOURCE_HAN_SANS_SC_14_CJK=y
CONFIG_LV_FONT_SOURCE_HAN_SANS_SC_16_CJK=y
CONFIG_LV_USE_FONT_PLACEHOLDER=y
CONFIG_LV_BUILD_EXAMPLES=n

# ---------------- Waveshare BSP ----------------
CONFIG_BSP_LCD_DPI_BUFFER_NUMS=3
CONFIG_BSP_LCD_COLOR_FORMAT_RGB565=y
CONFIG_CODEC_I2C_BACKWARD_COMPATIBLE=n

# ---------------- Xiaozhi 服务端地址 ----------------
# 改成你跑 FastAPI 服务端那台电脑的局域网 IP 和端口；必须能被开发板访问到。
# 也可以之后在 menuconfig -> Xiaozhi Assistant -> Default OTA URL 里修改。
CONFIG_XIAOZHI_OTA_URL="http://192.168.1.100:8000/xiaozhi/ota/"
CONFIG_XIAOZHI_INFO_TIMEOUT_MS=8000
