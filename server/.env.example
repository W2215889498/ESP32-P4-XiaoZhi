# ================= 小智服务端配置 =================
# 复制成 .env 后修改。所有变量前缀都是 XZ_

# ---------- 服务器 ----------
XZ_HOST=0.0.0.0
XZ_PORT=8000
# 设备通过代理/NAT 访问时，写死对外地址；留空则按请求的 Host 自动生成
# XZ_PUBLIC_WS_URL=ws://192.168.1.10:8000/xiaozhi/v1/

# ---------- LLM：DeepSeek（必填 Key）----------
XZ_LLM_PROVIDER=deepseek
XZ_LLM_BASE_URL=https://api.deepseek.com
# 留空则自动降级为 mock（用于先验证链路）；填上你自己的 Key 即启用真实 DeepSeek
XZ_LLM_API_KEY=
XZ_LLM_MODEL=deepseek-chat

# ---------- ASR：语音转文字 ----------
# 推荐（不需要任何 Key，识别在本机完成，离线可用）：
XZ_ASR_PROVIDER=local
#   XZ_ASR_LOCAL_MODEL=small        # tiny/base/small/medium/large-v3，默认 small
#   XZ_ASR_DEVICE=auto              # auto/cpu/cuda；auto 先试 GPU，失败自动退 CPU
# 首次识别会自动下载模型（国内默认走 hf-mirror.com 镜像），small 约 460MB。
#
# 也可以用云 ASR（需要 Key）：硅基流动 SenseVoice（免费额度）/ OpenAI / Groq 等
#   XZ_ASR_PROVIDER=openai
#   XZ_ASR_BASE_URL=https://api.siliconflow.cn/v1
#   XZ_ASR_API_KEY=<你的硅基流动 Key>
#   XZ_ASR_MODEL=FunAudioLLM/SenseVoiceSmall
# 留空 Key 且未装 faster-whisper 时会自动降级为 mock（用固定文本跑通链路）。
XZ_ASR_BASE_URL=https://api.siliconflow.cn/v1
XZ_ASR_API_KEY=
XZ_ASR_MODEL=FunAudioLLM/SenseVoiceSmall
XZ_ASR_LANGUAGE=zh
XZ_ASR_LOCAL_MODEL=small
XZ_ASR_DEVICE=auto

# ---------- TTS：文字转语音 ----------
# edge = 微软 Edge 语音（免费无需 Key，但需要能访问 speech.platform.bing.com）
XZ_TTS_PROVIDER=edge
XZ_TTS_VOICE=zh-CN-XiaoxiaoNeural
XZ_TTS_SAMPLE_RATE=16000

# 如果你的网络连不上 edge-tts（国内常见，日志报 Connection timeout），
# 改用硅基流动 TTS（可直接复用 ASR 的 Key），把下面几项填上：
#   XZ_TTS_PROVIDER=openai
#   XZ_TTS_BASE_URL=https://api.siliconflow.cn/v1
#   XZ_TTS_API_KEY=<你的硅基流动 Key>
#   XZ_TTS_MODEL=FunAudioLLM/CosyVoice2-0.5B
#   XZ_TTS_VOICE=FunAudioLLM/CosyVoice2-0.5B:alex   # voice 可选 alex/anna/bella/benjamin/...
# 另外：只要填了 XZ_TTS_API_KEY，edge 失败时会自动切换到上面这个 TTS（本会话内生效）。
XZ_TTS_BASE_URL=
XZ_TTS_API_KEY=
XZ_TTS_MODEL=tts-1

# ---------- TTS 输出响度（数字增益）----------
# 设备喇叭声音偏小时调这里（改完重启服务端即可，不用重烧固件）
XZ_TTS_NORMALIZE=true        # 自动把每句语音的峰值标准化到 -1dBFS（最多放大 +12dB）
XZ_TTS_EXTRA_GAIN_DB=0       # 还想更响就加大（如 3 / 6），过大会削波失真

# ---------- MCP：AI 控制设备硬件（GPIO 等）----------
# 打开后，服务端会在设备连上后作为 MCP 客户端向设备要 tools/list，
# 把工具描述交给 DeepSeek 做 function calling，再通过 tools/call 下发执行。
XZ_MCP_ENABLED=true
XZ_MCP_REQUEST_TIMEOUT=5
XZ_MCP_INIT_RETRY=4
# 一轮对话内最多允许模型连续调用工具的次数
XZ_LLM_TOOL_MAX_ROUNDS=4
# 模型只调工具、不说话时，先播这句垫场（留空关闭）
XZ_LLM_TOOL_FILLER=好的，我来处理。
